# Input for the golden tests: carserver.VehicleData with tire_pressure_state only, in protobuf text
# format (UC1017). Every field read by TirePressureFromBle is set, false included: oneof members have
# explicit presence, so false and 0 are on the wire and the .binpb carries every field number.
tire_pressure_state {
  timestamp { seconds: 1767254400 }
  tpms_pressure_fl: 2.9
  tpms_pressure_fr: 2.925
  tpms_pressure_rl: 2.1
  tpms_pressure_rr: 1.5
  tpms_last_seen_pressure_time_fl { seconds: 1767254100 }
  tpms_last_seen_pressure_time_fr { seconds: 1767254160 }
  tpms_last_seen_pressure_time_rl { seconds: 1767254220 }
  tpms_last_seen_pressure_time_rr { seconds: 1767254280 }
  tpms_hard_warning_fl: false
  tpms_hard_warning_fr: false
  tpms_hard_warning_rl: false
  tpms_hard_warning_rr: true
  tpms_soft_warning_fl: false
  tpms_soft_warning_fr: false
  tpms_soft_warning_rl: true
  tpms_soft_warning_rr: false
  tpms_rcp_front_value: 2.95
  tpms_rcp_rear_value: 3.1
}
