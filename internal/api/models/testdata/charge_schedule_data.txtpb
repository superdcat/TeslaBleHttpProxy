# Input for the golden tests: carserver.VehicleData with charge_schedule_state only, in protobuf
# text format (UC1019). Every field read by ChargeScheduleDataFromBle is set. ChargeSchedule fields
# are plain proto3 (false/0 not on the wire, hence omitted); oneof members of the state have
# explicit presence (show_schedule_complete_state: false is on the wire); values distinct between
# schedules and window.
charge_schedule_state {
  charge_schedules {
    id: 1767225600
    name: "Home"
    days_of_week: 62
    start_enabled: true
    start_time: 1380
    end_enabled: true
    end_time: 420
    enabled: true
    latitude: 45.764
    longitude: 4.8357
  }
  charge_schedules {
    id: 1767225601
    name: "Work"
    days_of_week: 65
    start_enabled: true
    start_time: 600
    end_time: 900
    one_time: true
    latitude: 44.8378
    longitude: -0.5792
  }
  charge_schedule_window {
    id: 1767225602
    days_of_week: 2
    start_enabled: true
    start_time: 1320
    end_enabled: true
    end_time: 360
    enabled: true
  }
  charge_buffer: 15
  max_num_charge_schedules: 10
  next_schedule: true
  show_schedule_complete_state: false
  timestamp { seconds: 1767254400 }
}
