# Input for the golden tests: carserver.VehicleData with preconditioning_schedule_state only, in
# protobuf text format (UC1019). Every field read by PreconditioningScheduleDataFromBle is set.
# PreconditionSchedule fields are plain proto3 (false/0 not on the wire, hence omitted); oneof
# members of the state have explicit presence; values distinct between schedules and window.
preconditioning_schedule_state {
  precondition_schedules {
    id: 1767225700
    name: "Home"
    days_of_week: 62
    precondition_time: 450
    enabled: true
    latitude: 45.764
    longitude: 4.8357
  }
  precondition_schedules {
    id: 1767225701
    days_of_week: 1
    precondition_time: 600
    one_time: true
    latitude: 44.8378
    longitude: -0.5792
  }
  preconditioning_schedule_window {
    id: 1767225702
    days_of_week: 2
    precondition_time: 480
    enabled: true
  }
  max_num_precondition_schedules: 10
  next_schedule: true
  timestamp { seconds: 1767254400 }
}
